# Klipper build config for the Sovol SV08 motion-control board.
# MCU: STM32F103 (GigaDevice GD32F103 clone), 28 KiB bootloader,
#       serial on USART1 (PA10/PA9), SWD disabled at startup.
#
# Source: klipper/config/printer-sovol-sv06-2022.cfg header notes —
#         the SV08 uses the same motion-control family as the SV06.
#
# Flash by copying out/klipper.bin (renamed firmware.bin, or any name
# ending in .bin that differs from the last flashed filename) to the
# root of an SD card, then booting the printer with the card inserted.

CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_STM32F103GD_DISABLE_SWD=y
CONFIG_FLASH_APPLICATION_START=0x7000
CONFIG_STM32_FLASH_START_7000=y
CONFIG_STM32_SERIAL_USART1=y
CONFIG_SERIAL=y
