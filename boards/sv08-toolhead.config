# Klipper build config for the Sovol SV08 TOOLHEAD MCU.
# MCU: STM32F103 (GigaDevice GD32F103 clone), 8 KiB Katapult bootloader,
#       serial on USART1 (PA10/PA9), SWD disabled at startup.
# Boot-time GPIO: PA6 (hotend fan) — ensures the hotend fan is spinning
#       before the Linux host takes over, important for thermal safety.
#
# Source: https://github.com/Rappetor/Sovol-SV08-Mainline (STEP 8.9)
# Flashed via Katapult over USB from the CB1 (no SD card method applies):
#   make flash_usb SERIAL=<the extra_mcu serial-by-id>
# The community update script ~/klipper/update_klipper_mcus_sv08.sh automates this.
#
# NOTE: This config is paired with boards/sv08-host.config — both MCUs
# run the same Klipper build but with different INITIAL_PINS.

CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_STM32F103GD_DISABLE_SWD=y
CONFIG_FLASH_APPLICATION_START=0x2000
CONFIG_STM32_FLASH_START_2000=y
CONFIG_STM32_SERIAL_USART1=y
CONFIG_SERIAL=y
CONFIG_INITIAL_PINS="PA6"
