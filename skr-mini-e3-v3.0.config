# Klipper build config for BIGTREETECH SKR Mini E3 v3.0
# MCU: STM32G0B1, 8 KiB bootloader, USB on PA11/PA12
# Built via GitHub Actions — see .github/workflows/build-firmware.yaml
#
# Source: derived from upstream config/generic-bigtreetech-skr-mini-e3-v3.0.cfg
#         and the Kconfig symbols in klipper/src/stm32/Kconfig.
# After make, copy out/klipper.bin to firmware.bin on an SD card.

CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32G0B1=y
CONFIG_FLASH_APPLICATION_START=0x2000
CONFIG_STM32_FLASH_START_2000=y
CONFIG_STM32_USB_PA11_PA12=y
CONFIG_USBSERIAL=y
